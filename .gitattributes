# Standard Git Attributes file for web repository
# Text files normalization
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf

# Web images should be stored as standard binary files directly in git
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.gif binary
*.svg binary
